+def _build_finalize_failure_payload(
+    reply: Any, *, diagnostic: str, history_persisted: bool = False
+) -> dict[str, Any]:
+    payload = build_tutor_payload(reply)
+    payload["history_persisted"] = history_persisted
+    payload["diagnostic"] = diagnostic
+    return payload
