+        if generation != getattr(self, "_native_barge_in_generation", None):
+            if pending:
+                self._native_barge_in_overflow = True
+                return True
+            config = VoiceActivationConfig()
+            self._native_barge_in_buffer = BoundedAudioFrameBuffer(
