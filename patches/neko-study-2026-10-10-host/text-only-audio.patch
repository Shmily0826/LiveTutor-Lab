+"""Explicit development-only mute for the isolated LiveTutor source host."""
+import json
+import os
+import threading
+from collections import Counter
+from pathlib import Path
+
+# Pin on import so a plugin reload cannot silently remove the process gate.
+ENABLED = os.environ.get("NEKO_DEV_TEXT_ONLY") == "1"
+COUNTS = Counter()
+_LOCK = threading.Lock()
+_AUDIT = os.environ.get("NEKO_DEV_AUDIO_AUDIT", "")
+
+
+def block(event):
+    """Count attempts without retaining any speech, image, or user text."""
+    if not ENABLED:
+        return False
+    with _LOCK:
+        COUNTS[event] += 1
+        if _AUDIT:
+            path = Path(_AUDIT)
+            path.parent.mkdir(parents=True, exist_ok=True)
+            with path.open("a", encoding="utf-8") as stream:
+                stream.write(json.dumps({"pid": os.getpid(), "event": event,
+                                         "count": COUNTS[event]}) + "\n")
+    return True
